#!/usr/bin/env python3
import argparse
from pathlib import Path

from amphiquantic.molecule.plot import plot_atoms
from rustquantic import PdbFilePy, minimize_topology, load_topology


def parse_args():
    parser = argparse.ArgumentParser(description="Minimize a structure using wgpu forces")
    parser.add_argument("input", type=str, help="PDB or .aqtop")
    parser.add_argument("-o", "--output", type=str, default=None)
    parser.add_argument("--plot", action="store_true", help="Show matplotlib plot")
    return parser.parse_args()


if __name__ == "__main__":
    args = parse_args()
    path = Path(args.input)

    if path.suffix == ".aqtop":
        out = args.output or str(path.with_suffix(".min.aqtop"))
        top, energy, iters = minimize_topology(str(path), out)
        coords, atom_types, bonds = top.to_pdb_types()
        print(f"Minimized in {iters} steps, E={energy:.4f} kJ/mol")
    else:
        pdb = PdbFilePy.parse(str(path))
        coords, atom_types = pdb.coords, pdb.atom_types
        bonds, _, _ = pdb.determine_bonds()
        from rustquantic import simulate as sm

        coords = sm.run_minimization(coords, atom_types, bonds)

    if args.plot or path.suffix != ".aqtop":
        plot_atoms(coords, atom_types, bonds)
