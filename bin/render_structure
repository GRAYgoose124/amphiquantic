#!/usr/bin/env python3
"""Render .aqtop structure to rotating MP4 or PNG frames."""

import argparse
import sys

from amphiquantic.visualization.traj_render import render_topology_spin


def parse_args():
    p = argparse.ArgumentParser(description="Render topology to rotating MP4 or PNG frames")
    p.add_argument("topology", type=str, help=".aqtop file")
    p.add_argument("-o", "--output", type=str, default=None)
    p.add_argument("--frames", type=int, default=36)
    p.add_argument("--fps", type=int, default=12)
    return p.parse_args()


def main():
    args = parse_args()
    out = render_topology_spin(
        args.topology,
        args.output,
        n_frames=args.frames,
        fps=args.fps,
    )
    if out is None:
        print("No frames rendered", file=sys.stderr)
        sys.exit(1)
    print(f"Wrote {out}")


if __name__ == "__main__":
    main()
