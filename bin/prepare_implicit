#!/usr/bin/env python3
"""Prepare topology for implicit GB solvation."""

import argparse
from pathlib import Path

from amphiquantic.topology.implicit import prepare_implicit_file


def parse_args():
    p = argparse.ArgumentParser(description="Assign Born radii and implicit metadata")
    p.add_argument("input", type=str, help=".aqtop input")
    p.add_argument("-o", "--output", type=str, required=True)
    p.add_argument("--model", type=str, default="gb_obc2")
    p.add_argument("--dielectric", type=float, default=78.5)
    return p.parse_args()


def main():
    args = parse_args()
    prepare_implicit_file(
        args.input,
        args.output,
        model=args.model,
        dielectric=args.dielectric,
    )
    print(f"Wrote implicit topology → {args.output}")


if __name__ == "__main__":
    main()
