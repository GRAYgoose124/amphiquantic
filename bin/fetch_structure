#!/usr/bin/env python3
"""Fetch a structure from RCSB (PDB and/or mmCIF)."""

import argparse
from pathlib import Path

from amphiquantic.structure import fetch_structure_text, mmcif_to_pdb, normalize_pdb_id, save_structure


def parse_args():
    p = argparse.ArgumentParser(description="Fetch PDB/mmCIF from RCSB")
    p.add_argument("pdb_id", help="Four-character PDB ID (e.g. 1CRN)")
    p.add_argument(
        "-o",
        "--output-dir",
        type=str,
        default=".",
        help="Directory for output files",
    )
    p.add_argument(
        "--format",
        choices=("pdb", "cif", "mmcif", "both"),
        default="both",
        help="Download format (default: both pdb and cif)",
    )
    p.add_argument(
        "--to-pdb",
        action="store_true",
        help="When fetching mmCIF only, also write converted .pdb",
    )
    return p.parse_args()


def main():
    args = parse_args()
    code = normalize_pdb_id(args.pdb_id)
    out_dir = Path(args.output_dir)

    if args.format == "both":
        paths = save_structure(code, out_dir, formats=("pdb", "cif"))
        for ext, path in paths.items():
            print(f"Wrote {path}")
        return

    fmt = "cif" if args.format in {"cif", "mmcif"} else "pdb"
    text = fetch_structure_text(code, fmt=fmt)
    suffix = ".cif" if fmt == "cif" else ".pdb"
    path = out_dir / f"{code.lower()}{suffix}"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    print(f"Wrote {path}")

    if args.to_pdb and fmt == "cif":
        pdb_path = out_dir / f"{code.lower()}.pdb"
        pdb_path.write_text(mmcif_to_pdb(text))
        print(f"Wrote {pdb_path} (converted from mmCIF)")


if __name__ == "__main__":
    main()
