#!/usr/bin/env python3
import argparse
import os
from pathlib import Path

from rustquantic import equilibrate_topology, load_topology, simulate_topology_gpu_resident


def parse_args():
    parser = argparse.ArgumentParser(description="NVT/NPT equilibration with configurable ensemble control")
    parser.add_argument("input", type=str, help=".aqtop topology")
    parser.add_argument("-o", "--output", type=str, default=None, help="Output .aqtop")
    parser.add_argument("--trajectory", type=str, default=None, help="Output .aqtrj")
    parser.add_argument("--steps", type=int, default=500)
    parser.add_argument("--temperature", type=float, default=300.0)
    parser.add_argument(
        "--restart",
        type=str,
        default=None,
        help="Restart coordinates from .aqtrj last frame",
    )
    parser.add_argument(
        "--restrain",
        action="store_true",
        help="Harmonic positional restraints to input coordinates",
    )
    parser.add_argument(
        "--restraint-k",
        type=float,
        default=1000.0,
        help="Restraint force constant kJ/mol/nm^2 (default 1000)",
    )
    parser.add_argument(
        "--traj-format",
        type=str,
        default=None,
        choices=["aqtrj", "dcd", "pdb", "xyz"],
        help="Trajectory output format (default: aqtrj)",
    )
    parser.add_argument(
        "--checkpoint",
        type=str,
        default=None,
        help="Write a binary checkpoint (positions, velocities, box, step, seed) at the end of the run",
    )
    parser.add_argument(
        "--checkpoint-in",
        type=str,
        default=None,
        help="Resume from a binary checkpoint written by --checkpoint",
    )
    parser.add_argument(
        "--energy-log",
        type=str,
        default=None,
        help="Write a CSV energy log (step,time_ps,potential,kinetic,total,temperature)",
    )
    parser.add_argument(
        "--thermostat",
        type=str,
        default="langevin",
        choices=["langevin", "berendsen", "vrescale", "nose-hoover", "none"],
        help="Thermostat algorithm (default: langevin)",
    )
    parser.add_argument(
        "--barostat",
        type=str,
        default=None,
        choices=["none", "berendsen", "montecarlo"],
        help="Barostat algorithm; enables NPT when set (default: off / NVT)",
    )
    parser.add_argument(
        "--pressure",
        type=float,
        default=1.0,
        help="Target pressure in bar for the barostat (default: 1.0)",
    )
    parser.add_argument(
        "--tau-t",
        type=float,
        default=None,
        help="Thermostat coupling time constant (ps)",
    )
    parser.add_argument(
        "--tau-p",
        type=float,
        default=None,
        help="Barostat coupling time constant (ps)",
    )
    parser.add_argument(
        "--com-remove-interval",
        type=int,
        default=None,
        help="Steps between center-of-mass motion removal (0 disables periodic removal)",
    )
    parser.add_argument(
        "--nh-chain-length",
        type=int,
        default=3,
        help="Nose-Hoover chain length (default: 3)",
    )
    parser.add_argument(
        "--mc-interval",
        type=int,
        default=None,
        help="Steps between Monte Carlo barostat attempts",
    )
    parser.add_argument(
        "--dt",
        type=float,
        default=None,
        help="Integration timestep in ps (default: 0.002; use e.g. 0.004 with --hmr)",
    )
    parser.add_argument(
        "--hmr",
        action="store_true",
        help="Hydrogen mass repartitioning (H mass -> 3.024 Da, preserving total mass)",
    )
    parser.add_argument(
        "--constraints",
        type=str,
        default=None,
        choices=["none", "h-bonds"],
        help="Bond constraint mode (default: h-bonds)",
    )
    parser.add_argument(
        "--constraint-algorithm",
        type=str,
        default=None,
        choices=["lincs", "shake"],
        help="Algorithm for solute H-bond constraints (default: lincs); water always uses analytic SETTLE",
    )
    parser.add_argument(
        "--threads",
        type=int,
        default=None,
        help="Number of CPU threads for the rayon-parallel force/constraint kernels (default: all cores)",
    )
    parser.add_argument(
        "--backend",
        type=str,
        default=None,
        choices=["cpu", "gpu", "hybrid", "gpu-resident"],
        help=(
            "Force evaluation backend (default: hybrid, or $AMPHI_FORCE_BACKEND). "
            "'gpu-resident' keeps positions/velocities/forces resident on the GPU "
            "across steps (see docs/gpu_resident.md); it does not support "
            "position restraints or solute LINCS/SHAKE constraints, and only "
            "--thermostat in {none, vrescale, langevin}. --barostat "
            "{none, berendsen, montecarlo} is supported."
        ),
    )
    return parser.parse_args()


def _run_gpu_resident(args, path: Path):
    if args.restrain:
        raise SystemExit("--backend gpu-resident does not support position restraints yet")
    if args.thermostat not in ("none", "vrescale", "langevin"):
        raise SystemExit(
            f"--backend gpu-resident supports --thermostat in {{none, vrescale, langevin}}, got {args.thermostat!r}"
        )
    traj = args.trajectory or str(path.with_suffix(".eq.aqtrj"))
    top, final_temperature, final_pressure = simulate_topology_gpu_resident(
        str(path),
        traj,
        args.steps,
        args.temperature,
        args.dt,
        args.thermostat,
        args.tau_t,
        None,
        args.energy_log,
        None,
        args.barostat or "none",
        args.pressure,
        args.tau_p,
        None,
        args.mc_interval,
    )
    out = args.output or str(path.with_suffix(".eq.aqtop"))
    top.write(out)
    print(
        f"Equilibrated (gpu-resident) → {out}, trajectory {traj} "
        f"(final T={final_temperature:.1f} K, P={final_pressure:.1f} bar)"
    )


if __name__ == "__main__":
    args = parse_args()
    path = Path(args.input)
    if args.backend:
        os.environ["AMPHI_FORCE_BACKEND"] = args.backend
        if args.backend != "hybrid":
            os.environ["AMPHI_HYBRID"] = "0"
    if args.backend == "gpu-resident":
        _run_gpu_resident(args, path)
        raise SystemExit(0)
    traj = args.trajectory or str(path.with_suffix(".eq.aqtrj"))
    restraint_k = args.restraint_k if args.restrain else None
    top, final_temperature, final_pressure = equilibrate_topology(
        str(path),
        traj,
        args.steps,
        args.temperature,
        args.restart,
        restraint_k,
        args.thermostat,
        args.barostat,
        args.pressure,
        args.tau_t,
        args.tau_p,
        args.com_remove_interval,
        args.nh_chain_length,
        args.mc_interval,
        traj_format=args.traj_format,
        checkpoint_out=args.checkpoint,
        checkpoint_in=args.checkpoint_in,
        energy_log=args.energy_log,
        dt=args.dt,
        hmr=args.hmr,
        constraints=args.constraints,
        constraint_algorithm=args.constraint_algorithm,
        threads=args.threads,
    )
    out = args.output or str(path.with_suffix(".eq.aqtop"))
    top.write(out)
    print(
        f"Equilibrated → {out}, trajectory {traj} "
        f"(final T={final_temperature:.1f} K, P={final_pressure:.1f} bar)"
    )
