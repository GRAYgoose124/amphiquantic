#!/usr/bin/env python3
import argparse
from pathlib import Path

from rustquantic import equilibrate_topology, load_topology


def parse_args():
    parser = argparse.ArgumentParser(description="NVT/NPT equilibration with configurable ensemble control")
    parser.add_argument("input", type=str, help=".aqtop topology")
    parser.add_argument("-o", "--output", type=str, default=None, help="Output .aqtop")
    parser.add_argument("--trajectory", type=str, default=None, help="Output .aqtrj")
    parser.add_argument("--steps", type=int, default=500)
    parser.add_argument("--temperature", type=float, default=300.0)
    parser.add_argument(
        "--restart",
        type=str,
        default=None,
        help="Restart coordinates from .aqtrj last frame",
    )
    parser.add_argument(
        "--restrain",
        action="store_true",
        help="Harmonic positional restraints to input coordinates",
    )
    parser.add_argument(
        "--restraint-k",
        type=float,
        default=1000.0,
        help="Restraint force constant kJ/mol/nm^2 (default 1000)",
    )
    parser.add_argument(
        "--traj-format",
        type=str,
        default=None,
        choices=["aqtrj", "dcd", "pdb", "xyz"],
        help="Trajectory output format (default: aqtrj)",
    )
    parser.add_argument(
        "--checkpoint",
        type=str,
        default=None,
        help="Write a binary checkpoint (positions, velocities, box, step, seed) at the end of the run",
    )
    parser.add_argument(
        "--checkpoint-in",
        type=str,
        default=None,
        help="Resume from a binary checkpoint written by --checkpoint",
    )
    parser.add_argument(
        "--energy-log",
        type=str,
        default=None,
        help="Write a CSV energy log (step,time_ps,potential,kinetic,total,temperature)",
    )
    parser.add_argument(
        "--thermostat",
        type=str,
        default="langevin",
        choices=["langevin", "berendsen", "vrescale", "nose-hoover", "none"],
        help="Thermostat algorithm (default: langevin)",
    )
    parser.add_argument(
        "--barostat",
        type=str,
        default=None,
        choices=["none", "berendsen", "montecarlo"],
        help="Barostat algorithm; enables NPT when set (default: off / NVT)",
    )
    parser.add_argument(
        "--pressure",
        type=float,
        default=1.0,
        help="Target pressure in bar for the barostat (default: 1.0)",
    )
    parser.add_argument(
        "--tau-t",
        type=float,
        default=None,
        help="Thermostat coupling time constant (ps)",
    )
    parser.add_argument(
        "--tau-p",
        type=float,
        default=None,
        help="Barostat coupling time constant (ps)",
    )
    parser.add_argument(
        "--com-remove-interval",
        type=int,
        default=None,
        help="Steps between center-of-mass motion removal (0 disables periodic removal)",
    )
    parser.add_argument(
        "--nh-chain-length",
        type=int,
        default=3,
        help="Nose-Hoover chain length (default: 3)",
    )
    parser.add_argument(
        "--mc-interval",
        type=int,
        default=None,
        help="Steps between Monte Carlo barostat attempts",
    )
    return parser.parse_args()


if __name__ == "__main__":
    args = parse_args()
    path = Path(args.input)
    traj = args.trajectory or str(path.with_suffix(".eq.aqtrj"))
    restraint_k = args.restraint_k if args.restrain else None
    top, final_temperature, final_pressure = equilibrate_topology(
        str(path),
        traj,
        args.steps,
        args.temperature,
        args.restart,
        restraint_k,
        args.thermostat,
        args.barostat,
        args.pressure,
        args.tau_t,
        args.tau_p,
        args.com_remove_interval,
        args.nh_chain_length,
        args.mc_interval,
        traj_format=args.traj_format,
        checkpoint_out=args.checkpoint,
        checkpoint_in=args.checkpoint_in,
        energy_log=args.energy_log,
    )
    out = args.output or str(path.with_suffix(".eq.aqtop"))
    top.write(out)
    print(
        f"Equilibrated → {out}, trajectory {traj} "
        f"(final T={final_temperature:.1f} K, P={final_pressure:.1f} bar)"
    )
