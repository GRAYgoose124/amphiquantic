#!/usr/bin/env python3
import argparse
from pathlib import Path

from rustquantic import simulate_topology


def parse_args():
    parser = argparse.ArgumentParser(description="Production MD simulation")
    parser.add_argument("input", type=str, help=".aqtop topology")
    parser.add_argument("-o", "--output", type=str, default=None)
    parser.add_argument("--trajectory", type=str, default=None)
    parser.add_argument("--steps", type=int, default=1000)
    parser.add_argument("--temperature", type=float, default=300.0)
    parser.add_argument(
        "--npt",
        action="store_true",
        help="Enable NPT barostat (experimental)",
    )
    parser.add_argument(
        "--restart",
        type=str,
        default=None,
        help="Restart coordinates from .aqtrj last frame",
    )
    parser.add_argument(
        "--traj-format",
        type=str,
        default=None,
        choices=["aqtrj", "dcd", "pdb", "xyz"],
        help="Trajectory output format (default: aqtrj)",
    )
    parser.add_argument(
        "--checkpoint",
        type=str,
        default=None,
        help="Write a binary checkpoint (positions, velocities, box, step, seed) at the end of the run",
    )
    parser.add_argument(
        "--checkpoint-in",
        type=str,
        default=None,
        help="Resume from a binary checkpoint written by --checkpoint",
    )
    parser.add_argument(
        "--energy-log",
        type=str,
        default=None,
        help="Write a CSV energy log (step,time_ps,potential,kinetic,total,temperature)",
    )
    return parser.parse_args()


if __name__ == "__main__":
    args = parse_args()
    path = Path(args.input)
    traj = args.trajectory or str(path.with_suffix(".md.aqtrj"))
    top = simulate_topology(
        str(path),
        traj,
        args.steps,
        args.temperature,
        args.restart,
        args.npt,
        traj_format=args.traj_format,
        checkpoint_out=args.checkpoint,
        checkpoint_in=args.checkpoint_in,
        energy_log=args.energy_log,
    )
    out = args.output or str(path.with_suffix(".md.aqtop"))
    top.write(out)
    print(f"Simulated → {out}, trajectory {traj}")
