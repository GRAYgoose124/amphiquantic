#!/usr/bin/env python3
import argparse
from pathlib import Path

from rustquantic import ionize_topology, load_topology


def parse_args():
    parser = argparse.ArgumentParser(description="Add ions to neutralize system charge")
    parser.add_argument("input", type=str, help=".aqtop input")
    parser.add_argument("-o", "--output", type=str, default=None)
    return parser.parse_args()


def main():
    args = parse_args()
    path = Path(args.input)
    out = args.output or str(path.with_suffix(".ion.aqtop"))

    if path.suffix != ".aqtop":
        raise SystemExit("ionize requires .aqtop input with force field terms")

    before = load_topology(str(path))
    n_atoms_before = before.num_atoms()
    top = ionize_topology(str(path), out)
    after = load_topology(out)
    print(
        f"Wrote {out} ({n_atoms_before} -> {after.num_atoms()} atoms, "
        f"net charge {after.net_charge():.4f})"
    )


if __name__ == "__main__":
    main()
