#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path

from amphiquantic.topology.io import load_topology, save_topology
from amphiquantic.topology.solvate import solvate_topology


def parse_args():
    parser = argparse.ArgumentParser(description="Solvate a system in a TIP3P water box")
    parser.add_argument("input", type=str, help=".aqtop input")
    parser.add_argument("-o", "--output", type=str, default=None, help="Output .aqtop")
    parser.add_argument("--padding", type=float, default=1.0, help="Padding distance (nm-ish)")
    parser.add_argument("--spacing", type=float, default=0.31, help="Water grid spacing (nm)")
    return parser.parse_args()


def main():
    args = parse_args()
    path = Path(args.input)
    out = args.output or str(path.with_suffix(".solv.aqtop"))

    if path.suffix != ".aqtop":
        print("solvate requires .aqtop input with bonded terms", file=sys.stderr)
        sys.exit(1)

    top = load_topology(path)
    solvated = solvate_topology(top, padding=args.padding, spacing=args.spacing)
    save_topology(out, solvated)
    print(f"Wrote {out} ({len(solvated['atoms'])} atoms)")


if __name__ == "__main__":
    main()
