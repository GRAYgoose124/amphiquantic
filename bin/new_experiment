#!/usr/bin/env python3
"""Create a new amphiquantic experiment (UUID folder + frozen protocol)."""

import argparse
from pathlib import Path

from amphiquantic.experiment.create import create_experiment


def parse_args():
    p = argparse.ArgumentParser(description="Create experiment from protocol template")
    p.add_argument(
        "--protocol",
        required=True,
        choices=[
            "protein_ligand_implicit",
            "protein_ligand_explicit",
            "enzyme_complex_implicit",
        ],
    )
    p.add_argument("--receptor", type=str, default=None, help="PDB path or RCSB ID")
    p.add_argument("--ligand", type=str, default=None, help="SMILES or file")
    p.add_argument(
        "--ligand-from-pdb",
        type=str,
        default=None,
        dest="ligand_from_pdb",
        help="Co-crystal ligand as PDB_ID:RESNAME (e.g. 1FKF:FK5)",
    )
    p.add_argument(
        "--ligand-resname",
        type=str,
        default=None,
        dest="ligand_resname",
        help="Reference ligand residue name for binding site",
    )
    p.add_argument("--cofactor", type=str, default=None)
    p.add_argument("--chain-b", type=str, default=None, dest="chain_b")
    p.add_argument("--out-dir", type=str, default=None, help="experiments/ parent dir")
    p.add_argument("--id", type=str, default=None, help="Optional fixed UUID")
    return p.parse_args()


def main():
    args = parse_args()
    out = create_experiment(
        args.protocol,
        experiments_dir=Path(args.out_dir) if args.out_dir else None,
        experiment_id=args.id,
        receptor=args.receptor,
        ligand=args.ligand,
        ligand_from_pdb=args.ligand_from_pdb,
        ligand_resname=args.ligand_resname,
        cofactor=args.cofactor,
        chain_b=args.chain_b,
    )
    print(out)


if __name__ == "__main__":
    main()
