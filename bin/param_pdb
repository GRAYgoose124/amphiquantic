#!/usr/bin/env python3
import argparse

from amphiquantic.molecule.plot import plot_molecule


def parse_args():
    parser = argparse.ArgumentParser(description="Parameterize (bond determine legacy) or plot PDB")
    parser.add_argument("pdb_file", type=str, help="Path to the PDB file")
    return parser.parse_args()


if __name__ == "__main__":
    args = parse_args()
    from rustquantic import PdbFilePy

    pdb_file = PdbFilePy.parse(args.pdb_file)
    pdb_file.determine_bonds()
    plot_molecule(args.pdb_file)
