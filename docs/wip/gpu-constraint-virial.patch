+// One pair's contribution to `constraints::compute_constraint_virial`:
+// `f_i = m_i*(post_i-pre_i)/dt^2`, accumulated for both `accumulate(i,j)`
+// and `accumulate(j,i)` (i.e. `dot(post_i-post_j, f_i) + dot(post_j-post_i,
+// f_j)`), scaled by the CPU function's trailing `0.5`.
+fn constraint_pair_virial(
+    post_i: vec3<f32>, pre_i: vec3<f32>, m_i: f32,
+    post_j: vec3<f32>, pre_j: vec3<f32>, m_j: f32,
+    inv_dt2: f32,
