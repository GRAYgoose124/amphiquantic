+    let f_i = m_i * (post_i - pre_i) * inv_dt2;
+    let f_j = m_j * (post_j - pre_j) * inv_dt2;
+    let raw = dot(post_i - post_j, f_i) + dot(post_j - post_i, f_j);
+    return 0.5 * raw;
+}
