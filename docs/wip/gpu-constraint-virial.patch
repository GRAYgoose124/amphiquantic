+    /// Runs the *same* short trajectory (same topology, same initial
+    /// velocities, V-rescale thermostat, SETTLE-constrained water) on the
+    /// CPU integrator and on `GpuResidentEngine`, and checks the two
+    /// backends' *mean* instantaneous pressure over the run agrees to a few
+    /// percent. This specifically exercises the constraint-virial fix: with
+    /// it, the previously-large SETTLE-virial gap between the two backends'
+    /// pressure closes. The two trajectories are not expected to stay
+    /// bit-identical (independent f64 CPU vs. f32 GPU integration diverges
+    /// chaotically step by step), so this compares the *ensemble mean*
+    /// over many steps, not a single instantaneous snapshot.
+    #[test]
+    fn mean_pressure_matches_cpu_reference_over_short_trajectory() {
+        if !have_gpu_adapter() {
+            eprintln!("skipping: no GPU/Vulkan adapter available");
+            return;
+        }
+        use crate::integrator::{initialize_velocities, md_step, MdState, Thermostat};
+
+        let top = periodic_water_box(2, 1.4);
+        let cutoff = 0.6; // comfortably below half the 1.4 nm box length
+        let dt = 0.0005;
+        let n_steps = 300usize;
+        let temperature = 300.0;
+        let velocities = initialize_velocities(&top, temperature);
+
+        // CPU reference trajectory.
+        std::env::set_var("AMPHI_FORCE_BACKEND", "cpu");
+        std::env::set_var("AMPHI_HYBRID", "0");
+        let mut cpu_state = MdState::new(top.clone(), temperature);
+        cpu_state.velocities = velocities.clone();
+        cpu_state.timestep = dt;
+        cpu_state.thermostat = Thermostat::VRescale;
+        cpu_state.tau_t = 0.5;
+        let mut cpu_pressures = Vec::with_capacity(n_steps);
+        for _ in 0..n_steps {
+            let res = md_step(&mut cpu_state, cutoff);
+            cpu_pressures.push(res.pressure);
+        }
+        let cpu_mean: f64 = cpu_pressures.iter().sum::<f64>() / cpu_pressures.len() as f64;
+
+        // GPU-resident trajectory, same topology/velocities/thermostat.
+        let mut engine = GpuResidentEngine::new(&top, cutoff);
+        engine.write_velocities(&velocities);
+        let result = engine.run(
+            &top,
+            n_steps,
+            dt,
+            GpuResidentThermostat::VRescale,
+            temperature,
+            0.5,
+            1,
+            5,
+            GpuResidentBarostat::None,
+            1.0,
+            2.0,
+            4.5e-5,
+            25,
+        );
+        let gpu_mean: f64 =
+            result.samples.iter().map(|s| s.pressure).sum::<f64>() / result.samples.len() as f64;
+
+        eprintln!("cpu_mean_pressure={cpu_mean} gpu_mean_pressure={gpu_mean}");
+        let rel = (gpu_mean - cpu_mean).abs() / cpu_mean.abs().max(1.0);
+        assert!(
+            rel < 0.05,
+            "mean pressure should agree within a few percent: cpu={cpu_mean} gpu={gpu_mean} rel={rel}"
+        );
+    }
