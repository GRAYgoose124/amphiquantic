+    /// A periodic `n_per_axis^3`-water TIP3P-geometry box on a regular
+    /// grid (mirrors `tests/validation/test_gpu_resident.py`'s
+    /// `_tip3p_water_box_aqtop`, same `roh`/HOH-angle convention), used to
+    /// exercise SETTLE at a realistic multi-water density under periodic
+    /// boundary conditions (as opposed to `water_topology`'s single,
+    /// aperiodic molecule).
+    fn water_box_topology(n_per_axis: usize, spacing_nm: f64) -> Topology {
+        // A regular lattice with every molecule in the *same* orientation
+        // produces local atom-atom overlaps (an H from one molecule
+        // sitting unusually close to a neighbor's O/H along the lattice
+        // axes) that are a packing artifact, not physics: any integrator
+        // (CPU or GPU, any thermostat) sees huge initial forces from that
+        // and diverges regardless of the Langevin/SETTLE coupling this
+        // test exists to check. Randomly orienting each rigid molecule
+        // (same bond lengths/angle, i.e. still exactly on the SETTLE
+        // manifold, just rotated) breaks that crystalline alignment and
+        // gives a well-conditioned, liquid-like starting configuration at
+        // the same real TIP3P density.
+        let roh = 0.09572;
+        let hoh: f64 = 1.824218134;
+        let box_len = n_per_axis as f64 * spacing_nm;
+        let mut top = Topology {
+            version: 1,
+            metadata: TopologyMetadata::default(),
+            box_: SimulationBox { lx: box_len, ly: box_len, lz: box_len, pbc: true },
+            atoms: Vec::new(),
+            bonds: Vec::new(),
+            angles: Vec::new(),
+            dihedrals: Vec::new(),
+            impropers: Vec::new(),
+            exclusions: Vec::new(),
+        };
+        // Alternate the H1/H2 orientation by lattice parity (not fully
+        // random: an arbitrary random rotation on this tight a lattice can
+        // just as easily swing an H directly into a neighbor, which is a
+        // *worse* packing artifact, not a more realistic one) so
+        // neighboring molecules aren't all eclipsed along the same axis,
+        // then relax with the existing L-BFGS minimizer (tight Fmax
+        // tolerance skipped — a few steps is enough to remove the
+        // remaining close contacts) before handing it to the integrator.
+        for ix in 0..n_per_axis {
+            for iy in 0..n_per_axis {
+                for iz in 0..n_per_axis {
+                    let ox = ix as f64 * spacing_nm;
+                    let oy = iy as f64 * spacing_nm;
+                    let oz = iz as f64 * spacing_nm;
+                    let base = top.atoms.len();
+                    let flip = (ix + iy + iz) % 2 == 1;
+                    let (h1x, h1y, h1z) = if flip { (0.0, roh, 0.0) } else { (roh, 0.0, 0.0) };
+                    let (h2x, h2y, h2z) = if flip {
+                        (roh * hoh.sin(), roh * hoh.cos(), 0.0)
+                    } else {
+                        (roh * hoh.cos(), roh * hoh.sin(), 0.0)
+                    };
+                    top.atoms.push(atom_elem(ox, oy, oz, -0.834, 15.999, "O"));
+                    top.atoms.push(atom_elem(ox + h1x, oy + h1y, oz + h1z, 0.417, 1.008, "H"));
+                    top.atoms.push(atom_elem(ox + h2x, oy + h2y, oz + h2z, 0.417, 1.008, "H"));
+                    top.bonds.push(BondTerm { i: base, j: base + 1, k: 450.0, r0: roh });
+                    top.bonds.push(BondTerm { i: base, j: base + 2, k: 450.0, r0: roh });
+                    top.angles.push(AngleTerm {
+                        i: base + 1,
+                        j: base,
+                        k: base + 2,
+                        k_theta: 55.0,
+                        theta0: hoh,
+                    });
+                }
+            }
+        }
+        top.build_exclusions();
+        top
+    }
